{
  "name": "@nord-forge/rime-core",
  "version": "0.0.0",
  "description": "The <rime-editor> Lit web component: canvas, drag-and-drop, inline rich text, chrome.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts",
    "./dist/richtext.js",
    "./src/richtext.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "bun": "./src/register.ts",
      "development": "./src/register.ts",
      "import": "./dist/register.js"
    },
    "./richtext": {
      "types": "./dist/richtext.d.ts",
      "bun": "./src/richtext.ts",
      "development": "./src/richtext.ts",
      "import": "./dist/richtext.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "bun test --conditions=development --path-ignore-patterns='**/e2e/**'",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json",
    "size": "cd ../.. && bun run scripts/measure.ts",
    "e2e": "playwright test",
    "bench:dnd": "bun run bench/dnd-perf.bench.ts"
  },
  "dependencies": {
    "@lexical/clipboard": "^0.23.1",
    "@lexical/html": "^0.23.1",
    "@lexical/link": "^0.23.1",
    "@lexical/list": "^0.23.1",
    "@lexical/rich-text": "^0.23.1",
    "@lexical/selection": "^0.23.1",
    "@lexical/utils": "^0.23.1",
    "@nord-forge/rime-model": "workspace:*",
    "lexical": "^0.23.1"
  },
  "devDependencies": {
    "@nord-forge/rime-mjml": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  }
}
