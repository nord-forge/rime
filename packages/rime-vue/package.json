{
  "name": "@nord-forge/rime-vue",
  "version": "0.0.0",
  "description": "Thin Vue wrapper for the <rime-editor> web component.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nord-forge/rime-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3"
  }
