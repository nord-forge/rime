  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@enveloppe/doc-model": "workspace:*",
    "mjml": "^4.15.3"
  }
}
