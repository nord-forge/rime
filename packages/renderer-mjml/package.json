{
  "name": "@nord-forge/rime-mjml",
  "version": "0.0.0",
  "description": "Default Rime Renderer: doc JSON → MJML → Outlook-safe email HTML.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json",
    "render:fixtures": "bun run scripts/render-fixtures.ts"
  },
  "dependencies": {
    "@nord-forge/rime-model": "workspace:*",
    "mjml": "^4.15.3"
  }
}
