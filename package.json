{
  "name": "rime",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, framework-agnostic email template builder.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test --conditions=development --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='**/spikes/**' --path-ignore-patterns='**/rime-react/**' --path-ignore-patterns='**/rime-vue/**' && bun run test:wrappers",
    "test:wrappers": "bun run --filter='@nord-forge/rime-react' test && bun run --filter='@nord-forge/rime-vue' test",
    "build": "bun run --filter='@nord-forge/*' build",
    "typecheck": "bun run --filter='@nord-forge/*' typecheck",
    "size": "bun run --filter='@nord-forge/rime-core' build && bun run scripts/measure.ts",
    "e2e": "bun run --filter='@nord-forge/rime-core' e2e",
    "demo": "bun run --filter='@nord-forge/rime-demo' dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/bun": "^1.1.14",
    "happy-dom": "^20.10.6",
    "lit": "^3.2.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@^7.3.1"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
