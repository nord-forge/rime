{
  "name": "@enveloppe/renderer-mjml",
  "version": "0.0.0",
  "description": "Default Enveloppe Renderer: doc JSON → MJML → Outlook-safe email HTML.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
